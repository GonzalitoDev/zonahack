# ════════════════════════════════════════════════════════════
# ZONAHACK + VIDEHUB - VARIABLES DE ENTORNO
# Copiá este archivo a .env y completá los valores.
# ════════════════════════════════════════════════════════════

# ── Supabase (base de datos principal) ──
# Clave publica (publishable) para lectura. Usá una clave con RLS restrictivo en produccion.
SUPABASE_KEY=sb_publishable_XXXX

# ── Autenticación server-side (/api/auth) ──
# OBLIGATORIAS en Vercel para que el login y los permisos funcionen:
#   SUPABASE_SERVICE_KEY -> service_role key (NUNCA exponerla en el navegador)
#   AUTH_SECRET          -> string largo y aleatorio (firma las sesiones)
# Si cambia AUTH_SECRET, se cierran todas las sesiones existentes.
SUPABASE_SERVICE_KEY=
AUTH_SECRET=
# Orígenes extra permitidos para CORS, separados por coma (opcional).
# Ej: https://offlinevideoplayer.vercel.app,https://zonahack.com
ALLOWED_ORIGINS=

# ── VideoHub: metadatos oficiales (TMDB) ──
# API oficial y documentada: https://developers.themoviedb.org/3
# Registrate gratis en https://www.themoviedb.org/settings/api
# VideoHub la usa SOLO para metadatos (título, año, géneros, póster, sinopsis).
# Sin esta clave el importador igual funciona con dominio público (Archive.org).
TMDB_API_KEY=

# ── VideoHub: contraseña admin del servidor ──
# Control adicional para las acciones de administración de /api/videohub.
# Si no se define, se valida el rol admin en la tabla "rangos" de Supabase.
VH_ADMIN_PASS=

# ── VPS Control (panel para administrar tu VPS por SSH) ──
# Control directo por SSH, sin depender de la API del proveedor.
# Estas mismas variables se configuran en Vercel -> Settings -> Environment Variables.
VPS_SSH_HOST=
VPS_SSH_USER=root
VPS_SSH_PORT=22
VPS_SSH_PASSWORD=
# O clave privada OpenSSH (si usás clave en vez de password):
VPS_SSH_KEY=
# Password de sudo (si sudo pide contraseña):
VPS_SSH_SUDO_PASS=
# Servicio systemd a controlar (start/stop/restart/logs). Default: zonahack
VPS_SERVICE=zonahack
# PIN opcional para que no cualquiera use el panel (misma config en Vercel).
VPS_PANEL_KEY=

# ── Web Scraper ──
# PIN opcional: si lo definís, guardar/listar/eliminar scrapeos exigen ?key=PIN
SCRAPER_KEY=

# ── Otros servicios existentes (opcionales, ya en uso) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3