{
  "name": "zonahack-pc",
  "productName": "ZonaHack",
  "version": "1.0.0",
  "description": "ZonaHack - App de escritorio conectada a la web (películas, anime, offline, tiempo real)",
  "main": "main.js",
  "author": "ZonaHack",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zonahack.pc",
    "productName": "ZonaHack",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "build/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZonaHack",
      "artifactName": "ZonaHack-Setup-${version}.${ext}"
    }
  }
}