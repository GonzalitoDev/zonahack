{
  "name": "cyberalerta-pc",
  "productName": "CyberAlerta",
  "version": "1.2.0",
  "description": "CyberAlerta - Noticias y novedades de ciberseguridad (solo para PC)",
  "main": "main.js",
  "author": "CyberAlerta",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "publish": {
    "provider": "generic",
    "url": "https://offlinevideoplayer.vercel.app"
  },
  "build": {
    "appId": "com.cyberalerta.pc",
    "productName": "CyberAlerta",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CyberAlerta",
      "artifactName": "CyberAlerta-Setup-${version}.${ext}"
    }
  }
}
